# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://postgres:password@localhost:5432/freelancehub
# REQUIRED: random string >= 32 characters. Never commit real production secrets.
SECRET_KEY=dev-only-replace-with-a-long-random-secret-key
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
PLATFORM_FEE_RATE=0.10
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# mock = demo self-confirm; set disabled in production until a real PSP + webhooks exist
PAYMENTS_MODE=mock
BCRYPT_ROUNDS=12

# Object storage for attachments (never store file bytes in PostgreSQL)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage
ATTACHMENT_MAX_BYTES=10485760
# For STORAGE_PROVIDER=s3 (private bucket; downloads still go through the API)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Gemini (server-side only — AI Brief + Messages assistant). Never use this as SECRET_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=30

# In-process rate limits (per IP). Prefer gateway/Redis limits when scaling out.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
